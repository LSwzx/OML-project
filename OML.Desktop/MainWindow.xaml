<ui:FluentWindow x:Class="OML.Desktop.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:pages="clr-namespace:OML.Desktop.Views.Pages"
                 Title="OML · Onion Minecraft Launcher"
                 Width="1120" Height="760"
                 MinWidth="900" MinHeight="600"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="OML · Onion Minecraft Launcher" />

        <ui:NavigationView x:Name="RootNavigation"
                           Grid.Row="1"
                           PaneDisplayMode="Left"
                           OpenPaneLength="200"
                           IsBackButtonVisible="Collapsed"
                           IsPaneToggleVisible="False">
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem Content="主页"
                                       Tag="home"
                                       TargetPageType="{x:Type pages:HomePage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Home24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="安装"
                                       Tag="install"
                                       TargetPageType="{x:Type pages:InstallPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="ArrowDownload24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="资源"
                                       Tag="mods"
                                       TargetPageType="{x:Type pages:ModsPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="PuzzlePiece24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="账号"
                                       Tag="accounts"
                                       TargetPageType="{x:Type pages:AccountsPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Person24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="设置"
                                       Tag="settings"
                                       TargetPageType="{x:Type pages:SettingsPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Settings24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
            </ui:NavigationView.MenuItems>
        </ui:NavigationView>

        <!-- 全局任务状态条 -->
        <Border Grid.Row="2"
                Padding="16,5"
                Background="{DynamicResource ControlFillColorSecondaryBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="{Binding Tasks.CurrentTaskText}"
                           FontSize="12"
                           MinWidth="180"
                           VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Tasks.HasFailed}" Value="True">
                                    <Setter Property="Foreground" Value="#FF6B6B" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <ProgressBar Grid.Column="1"
                             Margin="12,0"
                             Height="4"
                             VerticalAlignment="Center"
                             Minimum="0"
                             Maximum="100"
                             Value="{Binding Tasks.CurrentProgress}" />

                <ui:Button Grid.Column="2"
                           Content="取消"
                           Command="{Binding Tasks.CancelCommand}"
                           Height="24"
                           Padding="10,0"
                           Margin="0,0,8,0"
                           Visibility="{Binding Tasks.CanCancel, Converter={StaticResource BoolToVis}}" />

                <ui:Button Grid.Column="3"
                           Content="重试"
                           Command="{Binding Tasks.RetryCommand}"
                           Height="24"
                           Padding="10,0"
                           Margin="0,0,8,0"
                           Appearance="Primary"
                           Visibility="{Binding Tasks.HasFailed, Converter={StaticResource BoolToVis}}" />

                <TextBlock Grid.Column="4" FontSize="11" Opacity="0.6" VerticalAlignment="Center">
                    <Run Text="队列 " /><Run Text="{Binding Tasks.PendingCount, Mode=OneWay}" />
                </TextBlock>
            </Grid>
        </Border>

        <Border Grid.Row="3"
                Padding="16,6"
                Background="{DynamicResource ControlFillColorSecondaryBrush}">
            <TextBlock Text="{Binding ConfigPath, StringFormat=配置文件：{0}}"
                       Opacity="0.55"
                       FontSize="11"
                       TextTrimming="CharacterEllipsis" />
        </Border>
    </Grid>
</ui:FluentWindow>
