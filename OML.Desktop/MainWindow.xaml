<ui:FluentWindow x:Class="OML.Desktop.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="OML · Onion Minecraft Launcher"
                 Width="1080" Height="720"
                 MinWidth="880" MinHeight="560"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="OML · Onion Minecraft Launcher" />

        <Grid Grid.Row="1" Margin="16,4,16,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左：本地版本 -->
            <Border Grid.Column="0"
                    CornerRadius="8"
                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                    Padding="10">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="本地版本"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Margin="4,2,4,8" />

                    <ListBox ItemsSource="{Binding Versions}"
                             SelectedItem="{Binding SelectedVersion}"
                             BorderThickness="0"
                             Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="2,4">
                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                        <TextBlock Text="{Binding Type}" Opacity="0.6" FontSize="11" />
                                        <TextBlock Text="  ·  " Opacity="0.4" FontSize="11" />
                                        <TextBlock Text="{Binding ReleaseTime, StringFormat={}{0:yyyy-MM-dd}}"
                                                   Opacity="0.6" FontSize="11" />
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- 右：启动 + 进度 + 日志 -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal">
                    <ui:Button Content="启动游戏"
                               Command="{Binding LaunchCommand}"
                               Appearance="Primary"
                               MinWidth="132"
                               Height="40"
                               FontSize="15" />
                    <TextBlock Text="{Binding StatusText}"
                               VerticalAlignment="Center"
                               Margin="16,0,0,0"
                               Opacity="0.85"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <ProgressBar Grid.Row="1"
                             Height="4"
                             Margin="0,12,0,0"
                             Minimum="0"
                             Maximum="100"
                             Value="{Binding ProgressValue}" />

                <Border Grid.Row="2"
                        Margin="0,12,0,0"
                        CornerRadius="8"
                        Background="{DynamicResource ControlFillColorDefaultBrush}">
                    <TextBox Text="{Binding Logs, Mode=OneWay}"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             BorderThickness="0"
                             Background="Transparent"
                             Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                             FontFamily="Consolas"
                             FontSize="12"
                             Padding="10"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             TextChanged="LogBox_OnTextChanged" />
                </Border>
            </Grid>
        </Grid>

        <Border Grid.Row="2"
                Padding="16,6"
                Background="{DynamicResource ControlFillColorSecondaryBrush}">
            <TextBlock Text="{Binding ConfigPath, StringFormat=配置文件：{0}}"
                       Opacity="0.6"
                       FontSize="11"
                       TextTrimming="CharacterEllipsis" />
        </Border>
    </Grid>
</ui:FluentWindow>
