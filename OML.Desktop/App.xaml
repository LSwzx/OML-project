<Application x:Class="OML.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>

            <!-- 圆角：WPF-UI 控件统一从这里取 -->
            <CornerRadius x:Key="ControlCornerRadius">8</CornerRadius>
            <CornerRadius x:Key="OverlayCornerRadius">10</CornerRadius>

            <!-- Modrinth 绿 -->
            <SolidColorBrush x:Key="OMLGreenBrush" Color="#1BD96A" />

            <!--
                深色主题兜底：很多页面用的是普通 TextBlock，默认 Foreground 是系统黑色，
                在深灰背景上几乎不可读。这里给所有 TextBlock 一个浅色默认前景；
                控件自己设置过 Foreground 的地方仍然优先（本地值 > 样式）。
            -->
            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
