<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\OML.Core\OML.Core.csproj" />
    <ProjectReference Include="..\OML.Abstractions\OML.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Velopack" Version="1.2.161" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- 皮肤兜底图：编进程序集，单文件发布后仍可读取 -->
    <Resource Include="Assets\steve_head.png" />
    <Resource Include="Assets\steve_skin.png" />
    <!-- 启动器图标：窗口标题栏/任务栏用 -->
    <Resource Include="Assets\oml.ico" />
    <Resource Include="Assets\oml.png" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <Version>1.2.0</Version>
    <!-- exe 自身图标（资源管理器/快捷方式/任务栏） -->
    <ApplicationIcon>Assets\oml.ico</ApplicationIcon>
  </PropertyGroup>

  <!--
    单文件发布配置（仅 Release）：
    - WPF 不支持 IL 裁剪，PublishTrimmed 必须为 false，
      否则 XAML/BAML 反射会在运行时炸（启动即崩溃）。
    - SelfContained + win-x64：用户无需安装 .NET 运行时。
    - Debug 构建保持普通输出，不引入 RID 子目录，方便本地调试。
  -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

</Project>
