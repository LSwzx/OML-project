<Page x:Class="OML.Desktop.Views.Pages.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="主页">
    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <SolidColorBrush x:Key="OMLGreen" Color="#1BD96A" />
        <SolidColorBrush x:Key="OMLText" Color="#E6EAEF" />
        <SolidColorBrush x:Key="OMLMuted" Color="#8A93A0" />

        <Style x:Key="CardShell" TargetType="Border">
            <Setter Property="Background" Value="#1B1E23" />
            <Setter Property="BorderBrush" Value="#2B3037" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
        </Style>

        <Style x:Key="GhostButton" TargetType="ui:Button">
            <Setter Property="Appearance" Value="Secondary" />
            <Setter Property="Background" Value="#262A31" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="FontSize" Value="12" />
        </Style>
    </Page.Resources>

    <Grid Margin="20,16,20,16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="320" />
        </Grid.ColumnDefinitions>

        <!-- ============================ 中间 ============================ -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Java 卡片 -->
            <Border Grid.Row="0" PreviewMouseLeftButtonUp="OnJavaCardClick">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource CardShell}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsJavaSelected}" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource OMLGreen}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <ui:Card Background="Transparent" BorderThickness="0" Padding="0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="4" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Rectangle Grid.Column="0" Fill="{StaticResource OMLGreen}"
                                   Visibility="{Binding IsJavaSelected, Converter={StaticResource BoolToVis}}" />

                        <StackPanel Grid.Column="1" Margin="20,18,20,16">
                            <TextBlock Text="Java 版" FontSize="12" Foreground="{StaticResource OMLMuted}" Margin="0,0,0,6" />

                            <Button x:Name="VersionButton"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    HorizontalContentAlignment="Left"
                                    Padding="0"
                                    Command="{Binding ToggleVersionPickerCommand}">
                                <StackPanel>
                                    <TextBlock Text="{Binding SelectedVersionTitle}"
                                               FontSize="28"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource OMLText}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding SelectedVersionSubtitle}"
                                               FontSize="12"
                                               Foreground="{StaticResource OMLMuted}"
                                               Margin="0,4,0,0" />
                                </StackPanel>
                            </Button>

                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <ui:Button Content="版本设置" Style="{StaticResource GhostButton}" Click="OnVersionSettings" />
                                <ui:Button Content="模组管理" Style="{StaticResource GhostButton}" Click="OnModsClick" />
                                <ui:Button Content="高级设置" Style="{StaticResource GhostButton}" Click="OnAdvancedSettings" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </ui:Card>
            </Border>

            <!-- 版本选择弹层 -->
            <Popup x:Name="VersionPopup"
                   IsOpen="{Binding IsVersionPickerOpen}"
                   StaysOpen="False"
                   Placement="Bottom"
                   PlacementTarget="{Binding ElementName=VersionButton}"
                   AllowsTransparency="True"
                   PopupAnimation="Fade">
                <Border Background="#22262C"
                        BorderBrush="#2B3037"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="6"
                        Width="320"
                        MaxHeight="320">
                    <ListBox ItemsSource="{Binding Versions}"
                             SelectedItem="{Binding SelectedVersion}"
                             Background="Transparent"
                             BorderThickness="0"
                             MaxHeight="300"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionChanged="OnVersionPicked">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Foreground" Value="{StaticResource OMLText}" />
                                <Setter Property="Padding" Value="8,5" />
                                <Setter Property="Margin" Value="0,1" />
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#1F3D2B" />
                                        <Setter Property="Foreground" Value="{StaticResource OMLText}" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="2,4">
                                    <TextBlock Text="{Binding DisplayName}" Foreground="{StaticResource OMLText}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Type}" Foreground="{StaticResource OMLMuted}" FontSize="11" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </Popup>

            <!-- 基岩卡片 -->
            <Border Grid.Row="2" PreviewMouseLeftButtonUp="OnBedrockCardClick">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource CardShell}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsBedrockSelected}" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource OMLGreen}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <ui:Card Background="Transparent" BorderThickness="0" Padding="0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="4" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Rectangle Grid.Column="0" Fill="{StaticResource OMLGreen}"
                                   Visibility="{Binding IsBedrockSelected, Converter={StaticResource BoolToVis}}" />

                        <StackPanel Grid.Column="1" Margin="20,18,20,16">
                            <TextBlock Text="基岩版" FontSize="12" Foreground="{StaticResource OMLMuted}" Margin="0,0,0,6" />
                            <TextBlock Text="{Binding BedrockVersionText}"
                                       FontSize="24"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource OMLText}"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="点击卡片切换到基岩版"
                                       FontSize="11"
                                       Foreground="{StaticResource OMLMuted}"
                                       Margin="0,6,0,0" />
                        </StackPanel>
                    </Grid>
                </ui:Card>
            </Border>

            <!-- 日志 -->
            <Expander Grid.Row="4" Margin="0,12,0,0" IsExpanded="False">
                <Expander.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="启动日志" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource OMLText}" />
                        <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource OMLMuted}" FontSize="11" Margin="12,2,0,0" />
                    </StackPanel>
                </Expander.Header>
                <Border Background="#111316" CornerRadius="8" Margin="0,8,0,0">
                    <TextBox x:Name="LogBox"
                             Text="{Binding Logs}"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             TextWrapping="NoWrap"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="#C9D1D9"
                             FontFamily="Consolas"
                             FontSize="11"
                             Height="170"
                             Padding="10"
                             TextChanged="LogBox_OnTextChanged" />
                </Border>
            </Expander>
        </Grid>

        <!-- ============================ 右侧 ============================ -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <RowDefinition Height="*" />
                <RowDefinition Height="12" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 账号卡片 -->
            <Border Grid.Row="0" Style="{StaticResource CardShell}" PreviewMouseLeftButtonUp="OnAccountCardClick">
                <ui:Card Background="Transparent" BorderThickness="0" Padding="0">
                    <Grid Margin="16,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Width="44" Height="44" CornerRadius="22"
                                Background="{StaticResource OMLGreen}">
                            <TextBlock Text="{Binding AccountInitial}"
                                       Foreground="#0B0D0F"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>

                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding AccountName}" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{StaticResource OMLText}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding AccountTypeText}" FontSize="11" Foreground="{StaticResource OMLMuted}" />
                        </StackPanel>

                        <TextBlock Grid.Column="2" Text="▾" Foreground="{StaticResource OMLMuted}" VerticalAlignment="Center" />
                    </Grid>
                </ui:Card>
            </Border>

            <!-- 皮肤预览 -->
            <Border Grid.Row="2" Style="{StaticResource CardShell}">
                <Border CornerRadius="8" Margin="12" Background="#171A1F">
                    <Grid>
                        <Ellipse Width="120" Height="120" Fill="#232830" />
                        <TextBlock Text="{Binding AccountInitial}"
                                   FontSize="46"
                                   Foreground="#3B424C"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="皮肤预览"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Bottom"
                                   Margin="0,0,0,10"
                                   FontSize="11"
                                   Foreground="{StaticResource OMLMuted}" />
                    </Grid>
                </Border>
            </Border>

            <!-- 启动按钮 -->
            <ui:Button Grid.Row="4"
                       Content="{Binding LaunchButtonText}"
                       Command="{Binding LaunchCommand}"
                       Appearance="Primary"
                       Height="52"
                       HorizontalAlignment="Stretch"
                       HorizontalContentAlignment="Center"
                       FontSize="15"
                       FontWeight="SemiBold"
                       CornerRadius="10" />
        </Grid>
    </Grid>
</Page>

