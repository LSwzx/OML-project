<Page x:Class="OML.Desktop.Views.Pages.AccountsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20,8,20,20" MaxWidth="860" HorizontalAlignment="Left">

            <TextBlock Text="账号" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,16" />

            <!-- 当前账号 -->
            <Border CornerRadius="8"
                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                    Padding="16"
                    Margin="0,0,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Width="64"
                            Height="64"
                            CornerRadius="32"
                            Background="{DynamicResource AccentFillColorDefaultBrush}"
                            VerticalAlignment="Center">
                        <TextBlock Text="{Binding ProfileInitial}"
                                   Foreground="White"
                                   FontSize="26"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ProfileName}" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock Opacity="0.7" FontSize="12" Margin="0,4,0,0">
                            <Run Text="UUID：" /><Run Text="{Binding ProfileUuid, Mode=OneWay}" />
                        </TextBlock>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Opacity="0.7" FontSize="12">
                                <Run Text="类型：" /><Run Text="{Binding ProfileType, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Opacity="0.7" FontSize="12" Margin="16,0,0,0">
                                <Run Text="皮肤：" /><Run Text="{Binding ProfileSkin, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 微软正版登录 -->
            <Border CornerRadius="8"
                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                    Padding="20">
                <StackPanel>
                    <TextBlock Text="微软正版登录" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Text="使用微软账号登录（设备代码流程），登录后可启动 Java 版与基岩版。"
                               Opacity="0.6"
                               FontSize="11"
                               TextWrapping="Wrap"
                               Margin="0,4,0,14" />

                    <ui:Button Content="微软正版登录"
                               Command="{Binding StartMicrosoftLoginCommand}"
                               Appearance="Primary"
                               Height="36"
                               MinWidth="160"
                               HorizontalAlignment="Left" />

                    <StackPanel Visibility="{Binding IsMicrosoftLoginActive, Converter={StaticResource BoolToVis}}"
                                Margin="0,18,0,0">
                        <Border Height="1" Background="{DynamicResource ControlStrokeColorDefaultBrush}" Margin="0,0,0,16" />

                        <TextBlock Text="在浏览器中打开下面的地址，并输入代码："
                                   FontSize="12"
                                   Opacity="0.8" />
                        <TextBlock Text="{Binding MicrosoftVerificationUri}"
                                   FontSize="13"
                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,6,0,12" />

                        <TextBlock Text="设备代码"
                                   FontSize="11"
                                   Opacity="0.6" />
                        <TextBlock Text="{Binding MicrosoftUserCode}"
                                   FontSize="34"
                                   FontWeight="Bold"
                                   FontFamily="Consolas"
                                   Margin="0,2,0,14"
                                   TextWrapping="Wrap" />

                        <StackPanel Orientation="Horizontal">
                            <ui:Button Content="复制代码"
                                       Command="{Binding CopyMicrosoftCodeCommand}"
                                       Height="32"
                                       Padding="14,0"
                                       Margin="0,0,10,0" />
                            <ui:Button Content="打开浏览器"
                                       Command="{Binding OpenMicrosoftVerificationCommand}"
                                       Height="32"
                                       Padding="14,0"
                                       Margin="0,0,10,0" />
                            <ui:Button Content="取消"
                                       Command="{Binding CancelMicrosoftLoginCommand}"
                                       Height="32"
                                       Padding="14,0" />
                        </StackPanel>

                        <TextBlock Text="{Binding MicrosoftLoginStatus}"
                                   Opacity="0.75"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Margin="0,14,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock Text="{Binding StatusText}"
                       Opacity="0.8"
                       FontSize="12"
                       Margin="0,18,0,0"
                       TextWrapping="Wrap" />

            <TextBlock Text="当前版本仅支持微软正版账号；离线账号与外置登录已按合规要求移除。"
                       Opacity="0.5"
                       FontSize="11"
                       TextWrapping="Wrap"
                       Margin="0,8,0,0" />
        </StackPanel>
    </ScrollViewer>
</Page>
