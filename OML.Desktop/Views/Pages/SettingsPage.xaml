<Page x:Class="OML.Desktop.Views.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20,8,20,20" MaxWidth="820" HorizontalAlignment="Left">

            <TextBlock Text="设置" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,16" />

            <!-- 游戏目录 -->
            <TextBlock Text="游戏目录（.minecraft）" FontWeight="SemiBold" Margin="0,0,0,6" />
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0"
                         Text="{Binding GameDirectory, UpdateSourceTrigger=PropertyChanged}"
                         VerticalContentAlignment="Center"
                         Height="34" />
                <ui:Button Grid.Column="1"
                           Content="浏览…"
                           Command="{Binding BrowseGameDirectoryCommand}"
                           Margin="8,0,0,0"
                           Height="34" />
            </Grid>

            <!-- 内存 -->
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="最大内存分配" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1"
                           Text="{Binding MaxMemoryMB, StringFormat={}{0:0} MB}"
                           Opacity="0.8"
                           VerticalAlignment="Center" />
            </Grid>
            <Slider Minimum="1024"
                    Maximum="8192"
                    TickFrequency="512"
                    IsSnapToTickEnabled="True"
                    Value="{Binding MaxMemoryMB}"
                    Margin="0,0,0,16" />

            <!-- 资源补全 -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="启动前补全资源文件" FontWeight="SemiBold" />
                    <TextBlock Text="1.21.1 全量约 800MB；关闭可显著加快首次启动，但会缺贴图/音效。"
                               Opacity="0.6"
                               FontSize="11"
                               TextWrapping="Wrap"
                               MaxWidth="560"
                               HorizontalAlignment="Left" />
                </StackPanel>
                <ui:ToggleSwitch Grid.Column="1"
                                 IsChecked="{Binding CompleteAssets}"
                                 VerticalAlignment="Center" />
            </Grid>

            <!-- 自动检查更新 -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="启动时自动检查更新" FontWeight="SemiBold" />
                    <TextBlock Text="安装版会在启动后静默检查，有新版本时在窗口顶部提示；便携版无法自动更新。"
                               Opacity="0.6"
                               FontSize="11"
                               TextWrapping="Wrap"
                               MaxWidth="560"
                               HorizontalAlignment="Left" />
                </StackPanel>
                <ui:ToggleSwitch Grid.Column="1"
                                 IsChecked="{Binding AutoCheckUpdates}"
                                 VerticalAlignment="Center" />
            </Grid>

            <!-- 版本隔离 -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="启用版本隔离" FontWeight="SemiBold" />
                    <TextBlock Text="每个版本拥有独立的 mods 和 config 文件夹"
                               Opacity="0.6"
                               FontSize="11"
                               TextWrapping="Wrap"
                               MaxWidth="560"
                               HorizontalAlignment="Left" />
                </StackPanel>
                <ui:ToggleSwitch Grid.Column="1"
                                 IsChecked="{Binding VersionIsolation}"
                                 VerticalAlignment="Center" />
            </Grid>

            <!-- Java -->
            <TextBlock Text="Java 路径" FontWeight="SemiBold" Margin="0,0,0,6" />
            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0"
                         Text="{Binding JavaPath, UpdateSourceTrigger=PropertyChanged}"
                         VerticalContentAlignment="Center"
                         Height="34" />
                <ui:Button Grid.Column="1"
                           Content="浏览…"
                           Command="{Binding BrowseJavaCommand}"
                           Margin="8,0,0,0"
                           Height="34" />
                <ui:Button Grid.Column="2"
                           Content="自动"
                           Command="{Binding ClearJavaCommand}"
                           Margin="8,0,0,0"
                           Height="34" />
            </Grid>
            <TextBlock Text="留空表示自动探测（JAVA_HOME → 注册表 → 常见目录 → PATH）。"
                       Opacity="0.6"
                       FontSize="11"
                       Margin="0,0,0,16" />

            <!-- Java 探测结果 -->
            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="当前 Java 探测结果" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding JavaScanStatus}" Opacity="0.55" FontSize="11" Margin="12,2,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <ui:Button Content="自动下载 Java"
                               Command="{Binding AutoDownloadJavaCommand}"
                               Height="30"
                               Padding="12,0"
                               Margin="0,0,8,0"
                               Appearance="Primary" />
                    <ui:Button Content="重新探测"
                               Command="{Binding ScanJavaCommand}"
                               Height="30"
                               Padding="12,0" />
                </StackPanel>
            </Grid>

            <ListBox ItemsSource="{Binding DetectedJavas}"
                     MaxHeight="150"
                     BorderThickness="0"
                     Background="{DynamicResource ControlFillColorDefaultBrush}"
                     Margin="0,0,0,16">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="4,3">
                            <TextBlock FontSize="12">
                                <Run Text="Java " /><Run Text="{Binding MajorVersion, Mode=OneWay}" />
                                <Run Text="  ·  " Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <Run Text="{Binding Source, Mode=OneWay}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </TextBlock>
                            <TextBlock Text="{Binding Path}"
                                       Opacity="0.55"
                                       FontSize="11"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- 更新源 -->
            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="更新源" FontWeight="SemiBold" />
                    <TextBlock Text="切换后下一次检查立即生效。镜像/自定义请填包含 releases.win.json 的更新源地址。"
                               Opacity="0.6"
                               FontSize="11"
                               TextWrapping="Wrap"
                               MaxWidth="560"
                               HorizontalAlignment="Left" />
                </StackPanel>
                <ComboBox Grid.Column="1"
                          Width="160"
                          ItemsSource="{Binding UpdateSourceOptions}"
                          SelectedIndex="{Binding UpdateSourceIndex}"
                          VerticalAlignment="Center" />
            </Grid>

            <TextBox Text="{Binding UpdateSourceUrl}"
                     IsEnabled="{Binding IsCustomUpdateSource}"
                     Height="32"
                     Margin="0,0,0,12"
                     VerticalContentAlignment="Center"
                     ToolTip="例如 https://ghproxy.com/https://github.com/.../releases/download/" />
            <TextBlock Text="{Binding StatusText}" Opacity="0.75" FontSize="12" Margin="0,0,0,4" />

            <StackPanel Orientation="Horizontal" Margin="0,10,0,12">
                <ui:Button Content="检查更新"
                           Command="{Binding CheckUpdatesCommand}"
                           Height="32"
                           Padding="14,0"
                           Margin="0,0,10,0" />
                <ui:Button Content="导出诊断日志"
                           Command="{Binding ExportDiagnosticsCommand}"
                           Height="32"
                           Padding="14,0" />
            </StackPanel>

            <TextBlock Text="{Binding ConfigPath, StringFormat=配置文件：{0}}"
                       Opacity="0.5"
                       FontSize="11"
                       TextTrimming="CharacterEllipsis" />
        </StackPanel>
    </ScrollViewer>
</Page>
