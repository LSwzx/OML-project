<Page x:Class="OML.Desktop.Views.Pages.SkinPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:OML.Desktop.Controls"
      Title="皮肤">
    <Grid Margin="20,16" TextElement.Foreground="#E6EAEF">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="皮肤" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Text="3D 皮肤预览：拖动模型可旋转；离线账号使用内置 Steve 皮肤。"
                       Opacity="0.55"
                       FontSize="12"
                       Margin="0,6,0,0" />
        </StackPanel>

        <ui:Card Grid.Row="1" Padding="24" Background="#1C1F24">
            <Grid>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Border Width="320" Height="420" CornerRadius="12" Background="#171A1F">
                        <controls:SkinView SkinSource="{Binding SkinBitmap}" Width="300" Height="400" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="拖动可旋转；离线/无皮肤时显示内置 Steve"
                               HorizontalAlignment="Center"
                               Margin="0,14,0,0"
                               Opacity="0.5"
                               FontSize="12" />
                </StackPanel>
            </Grid>
        </ui:Card>
    </Grid>
</Page>
