<Page x:Class="OML.Desktop.Views.Pages.ModsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Grid Margin="20,8,20,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 搜索栏 -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ComboBox Grid.Column="0"
                      ItemsSource="{Binding Categories}"
                      SelectedIndex="{Binding SelectedCategoryIndex}"
                      Width="104"
                      Height="36"
                      Margin="0,0,8,0"
                      VerticalContentAlignment="Center" />

            <TextBox Grid.Column="1"
                     Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                     Height="36"
                     VerticalContentAlignment="Center" />

            <ui:Button Grid.Column="2"
                       Content="搜索"
                       Command="{Binding SearchCommand}"
                       Appearance="Primary"
                       Height="36"
                       MinWidth="96"
                       Margin="8,0,0,0" />

            <TextBlock Grid.Column="3"
                       Text="{Binding TargetText}"
                       VerticalAlignment="Center"
                       Opacity="0.6"
                       FontSize="12"
                       Margin="14,0,0,0" />
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="380" />
            </Grid.ColumnDefinitions>

            <!-- 结果列表 -->
            <ListBox Grid.Column="0"
                     ItemsSource="{Binding Results}"
                     SelectedItem="{Binding SelectedItem}"
                     BorderThickness="0"
                     Background="Transparent"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.IsVirtualizing="True">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="2,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Width="48"
                                    Height="48"
                                    CornerRadius="6"
                                    Background="{DynamicResource ControlFillColorSecondaryBrush}">
                                <Image Source="{Binding Icon}"
                                       Width="48"
                                       Height="48"
                                       Stretch="UniformToFill" />
                            </Border>

                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Description}"
                                           Opacity="0.6"
                                           FontSize="11"
                                           MaxHeight="32"
                                           TextWrapping="Wrap"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding DownloadsText, StringFormat=↓ {0}}"
                                           Opacity="0.45"
                                           FontSize="11" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- 详情 -->
            <Border Grid.Column="2"
                    CornerRadius="8"
                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                    Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="{Binding DetailTitle}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Grid.Row="1" Text="{Binding DetailText}" Opacity="0.7" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0" />
                    <TextBlock Grid.Row="2" Text="{Binding VersionText}" Opacity="0.85" FontSize="12" TextWrapping="Wrap" Margin="0,12,0,0" />

                    <ui:Button Grid.Row="3"
                               Content="{Binding DownloadButtonText}"
                               Command="{Binding DownloadCommand}"
                               Appearance="Primary"
                               Margin="0,14,0,0"
                               Height="36"
                               MinWidth="140"
                               HorizontalAlignment="Left" />

                    <StackPanel Grid.Row="4" VerticalAlignment="Bottom">
                        <ProgressBar Height="4" Margin="0,12,0,0" Minimum="0" Maximum="100" Value="{Binding ProgressValue}" />
                        <TextBlock Text="{Binding StatusText}" Opacity="0.75" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
