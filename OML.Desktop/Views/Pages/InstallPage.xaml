<Page x:Class="OML.Desktop.Views.Pages.InstallPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Grid Margin="20,8,20,12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 左：在线版本 -->
        <Border Grid.Column="0"
                CornerRadius="8"
                Background="{DynamicResource ControlFillColorDefaultBrush}"
                Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="在线版本"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Margin="2,0,0,8" />

                <ComboBox Grid.Row="1"
                          ItemsSource="{Binding Filters}"
                          SelectedIndex="{Binding SelectedFilterIndex}"
                          Margin="0,0,0,8" />

                <ListBox Grid.Row="2"
                         ItemsSource="{Binding Versions}"
                         SelectedItem="{Binding SelectedVersion}"
                         BorderThickness="0"
                         Background="Transparent"
                         VirtualizingPanel.IsVirtualizing="True"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="2,3">
                                <TextBlock Text="{Binding Id}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding ReleaseTime, StringFormat={}{0:yyyy-MM-dd}}"
                                           Opacity="0.55"
                                           FontSize="11" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- 右：详情 + 安装 -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="安装" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,12" />

            <Border Grid.Row="1"
                    CornerRadius="8"
                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                    Padding="16">
                <StackPanel>
                    <TextBlock Text="{Binding DetailText}" TextWrapping="Wrap" LineHeight="22" />
                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <ui:Button Content="安装此版本"
                                   Command="{Binding InstallCommand}"
                                   Appearance="Primary"
                                   Height="36"
                                   MinWidth="130" />
                        <ui:Button Content="安装 Fabric"
                                   Command="{Binding InstallFabricCommand}"
                                   Margin="10,0,0,0"
                                   Height="36"
                                   MinWidth="120" />
                        <ui:Button Content="安装 Forge"
                                   Command="{Binding InstallForgeCommand}"
                                   Margin="10,0,0,0"
                                   Height="36"
                                   MinWidth="120" />
                        <ui:Button Content="导入 OptiFine"
                                   Command="{Binding ImportOptiFineCommand}"
                                   Margin="10,0,0,0"
                                   Height="36"
                                   MinWidth="130"
                                   ToolTip="OptiFine 没有公开的静默安装接口，导入后会运行它的图形安装器" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <StackPanel Grid.Row="2" Margin="0,16,0,0">
                <TextBlock Text="{Binding StatusText}" Opacity="0.8" FontSize="12" TextWrapping="Wrap" />
                <ProgressBar Height="4" Margin="0,8,0,0" Minimum="0" Maximum="100" Value="{Binding ProgressValue}" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
