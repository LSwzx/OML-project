<Page x:Class="OML.Desktop.Views.Pages.InstallPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="下载">
    <Page.Resources>
        <SolidColorBrush x:Key="OMLText" Color="#E6EAEF" />
        <SolidColorBrush x:Key="OMLMuted" Color="#8A93A0" />

        <Style x:Key="HideWhenDetail" TargetType="FrameworkElement">
            <Setter Property="Visibility" Value="Visible" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDetailOpen}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ShowWhenDetail" TargetType="FrameworkElement">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDetailOpen}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <Grid Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 搜索 + 类型筛选（列表模式） -->
        <Grid Grid.Row="0" Margin="0,0,0,12" Style="{StaticResource HideWhenDetail}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     Height="36"
                     VerticalContentAlignment="Center"
                     ToolTip="按版本号搜索，例如 1.20" />

            <ComboBox Grid.Column="1"
                      ItemsSource="{Binding Filters}"
                      SelectedIndex="{Binding SelectedFilterIndex}"
                      Width="120"
                      Height="36"
                      Margin="8,0,0,0"
                      VerticalContentAlignment="Center" />

            <TextBlock Grid.Column="2"
                       Text="{Binding StatusText}"
                       Foreground="{StaticResource OMLMuted}"
                       FontSize="12"
                       VerticalAlignment="Center"
                       Margin="14,0,0,0" />
        </Grid>

        <!-- 版本列表（PCL 式：只有列表，点击进入向导） -->
        <Border Grid.Row="1"
                CornerRadius="12"
                Background="#1B1E23"
                BorderBrush="#2B3037"
                BorderThickness="1"
                Padding="8"
                Style="{StaticResource HideWhenDetail}">
            <ListBox x:Name="VersionList"
                     ItemsSource="{Binding Versions}"
                     SelectedItem="{Binding SelectedVersion}"
                     PreviewMouseLeftButtonUp="OnVersionListMouseUp"
                     Background="Transparent"
                     BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="10,8" />
                        <Setter Property="Margin" Value="0,2" />
                        <Setter Property="Foreground" Value="{StaticResource OMLText}" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding Id}" FontSize="15" FontWeight="SemiBold"
                                           Foreground="{StaticResource OMLText}" />
                                <TextBlock Text="{Binding Type}" FontSize="11"
                                           Foreground="{StaticResource OMLMuted}" />
                            </StackPanel>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding ReleaseTime, StringFormat={}{0:yyyy-MM-dd}}"
                                       FontSize="12"
                                       Foreground="{StaticResource OMLMuted}"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- 版本下载向导（独立面板） -->
        <Border Grid.Row="0" Grid.RowSpan="2"
                Width="600"
                MaxHeight="680"
                Background="#1B1E23"
                BorderBrush="#2B3037"
                BorderThickness="1"
                CornerRadius="14"
                Padding="26"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Style="{StaticResource ShowWhenDetail}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="{Binding SelectedVersion.Id, StringFormat=安装 {0}}"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource OMLText}" />

                    <TextBlock Text="{Binding SelectedVersion.Type, StringFormat=类型：{0}}"
                               FontSize="12"
                               Foreground="{StaticResource OMLMuted}"
                               Margin="0,6,0,0" />
                    <TextBlock Text="{Binding SelectedVersion.ReleaseTime, StringFormat=发布时间：{0:yyyy-MM-dd HH:mm}}"
                               FontSize="12"
                               Foreground="{StaticResource OMLMuted}"
                               Margin="0,2,0,0" />

                    <Border Height="1" Background="#2B3037" Margin="0,16" />

                    <CheckBox Content="补全完整的游戏资源（Assets，推荐）"
                              IsChecked="{Binding InstallAssetsOption}"
                              Foreground="{StaticResource OMLText}"
                              Margin="0,0,0,10" />

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <CheckBox Grid.Column="0"
                                  Content="安装 Forge"
                                  IsChecked="{Binding InstallForgeOption}"
                                  Foreground="{StaticResource OMLText}"
                                  VerticalAlignment="Center"
                                  MinWidth="150" />
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding ForgeVersions}"
                                  SelectedItem="{Binding ForgeVersion}"
                                  IsEnabled="{Binding InstallForgeOption}"
                                  Height="30" />
                    </Grid>

                    <CheckBox Content="安装 Fabric"
                              IsChecked="{Binding InstallFabricOption}"
                              Foreground="{StaticResource OMLText}"
                              Margin="0,0,0,10" />

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <CheckBox Grid.Column="0"
                                  Content="安装 OptiFine"
                                  IsChecked="{Binding InstallOptiFineOption}"
                                  Foreground="{StaticResource OMLText}"
                                  VerticalAlignment="Center"
                                  MinWidth="150" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding OptiFineJarPath, TargetNullValue=尚未选择安装包}"
                                   FontSize="11"
                                   Foreground="{StaticResource OMLMuted}"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                        <ui:Button Grid.Column="2"
                                   Content="选择…"
                                   Command="{Binding PickOptiFineCommand}"
                                   Height="28"
                                   Padding="12,0" />
                    </Grid>

                    <TextBlock Text="安装会进入后台队列，可以在底部查看进度，切换页面不会中断。"
                               FontSize="11"
                               Foreground="{StaticResource OMLMuted}"
                               Margin="0,12,0,0" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                        <ui:Button Content="取消"
                                   Command="{Binding CloseDetailCommand}"
                                   Height="36"
                                   MinWidth="90"
                                   Margin="0,0,10,0" />
                        <ui:Button Content="开始下载"
                                   Command="{Binding BeginDownloadCommand}"
                                   Appearance="Primary"
                                   Height="36"
                                   MinWidth="120" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Page>
